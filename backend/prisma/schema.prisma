generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum AdminRole {
  ADMIN
  PROJECT_MANAGER
  SUPPORT
  EDITOR
  FINANCE
  DESIGNER_DEV
  ATTENDANCE
}

enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  WAITING_CLIENT
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum StageStatus {
  DRAFT
  IN_PROGRESS
  SENT_TO_CLIENT
  WAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  COMPLETED
  ARCHIVED
}

enum BriefingStatus {
  DRAFT
  SENT
  ANSWERED
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum ApprovalStatus {
  DRAFT
  SENT
  WAITING_CLIENT
  APPROVED
  CHANGES_REQUESTED
  RESENT
  CANCELLED
}

enum PreviewStatus {
  DRAFT
  SENT
  IN_APPROVAL
  APPROVED
  ARCHIVED
}

enum RequestStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum VisibilityStatus {
  INTERNAL
  VISIBLE_TO_CLIENT
}

enum InboxChannel {
  CLIENTS
  SUPPORT
}

enum InboxStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  ARCHIVED
}

enum InboxSource {
  PORTAL_CLIENT
  SUPPORT
  APPROVAL
  REQUEST
  FILE
  FINANCE
  SCHEDULE
  CONTACT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FileOrigin {
  CLIENT
  ATELIUX
  SYSTEM
  PUBLIC
}

enum FileStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  DELETED
}

enum FileVisibility {
  PRIVATE
  CLIENT_VISIBLE
  PUBLIC
}

enum FileUploadedByType {
  CLIENT
  ADMIN
  PUBLIC
  SYSTEM
}

enum FileRiskLevel {
  SAFE_PREVIEW
  DOWNLOAD_ONLY
  HIGH_RISK_DOWNLOAD_ONLY
}

enum FileDownloadMode {
  INLINE_ALLOWED
  ATTACHMENT_ONLY
}

enum FileContext {
  AVATAR
  BLOG_COVER
  BLOG_HERO
  CONTACT_ATTACHMENT
  SUPPORT_ATTACHMENT
  CLIENT_FILE
  APPROVAL_ATTACHMENT
  BRIEFING_ATTACHMENT
  FINANCE_RECEIPT
  PREVIEW_ASSET
}

enum FileScanStatus {
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum FinanceStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum BlogCommentStatus {
  PUBLISHED
  DELETED
}

enum NewsletterStatus {
  ACTIVE
  NEW
  UNSUBSCRIBED
}

enum ContactLeadStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum NotificationAudience {
  CLIENT
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  adminProfile   AdminUser?
  clientAccount  ClientAccount?
  refreshTokens  RefreshToken[]
  sentMessages   InboxMessage[]
  uploadedFiles  FileAsset[]
  notifications  Notification[]
  blogComments   BlogComment[]
  savedBlogPosts SavedBlogPost[]
  blogShares     BlogShare[]
  cookieConsents CookieConsent[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminUser {
  id        String    @id @default(cuid())
  userId    String    @unique
  role      AdminRole
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedClients        Client[]            @relation("ClientResponsible")
  managedProjects       Project[]           @relation("ProjectManager")
  projectMemberships    ProjectTeamMember[]
  assignedConversations InboxConversation[] @relation("ConversationAssignee")
  blogPosts             BlogPost[]

  @@index([role])
}

model Client {
  id            String        @id @default(cuid())
  name          String
  company       String
  email         String        @unique
  phone         String?
  plan          String
  status        AccountStatus @default(INVITED)
  responsibleId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  responsible        AdminUser?          @relation("ClientResponsible", fields: [responsibleId], references: [id])
  account            ClientAccount?
  projects           Project[]
  projectStages      ProjectStage[]
  briefings          Briefing[]
  briefingResponses  BriefingResponse[]
  approvals          Approval[]
  previews           Preview[]
  clientRequests     ClientRequest[]
  supportTickets     SupportTicket[]
  inboxConversations InboxConversation[]
  files              FileAsset[]
  scheduleEvents     ScheduleEvent[]
  financeRecords     FinanceRecord[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([responsibleId])
}

model ClientAccount {
  id           String        @id @default(cuid())
  clientId     String        @unique
  userId       String        @unique
  inviteStatus AccountStatus @default(INVITED)
  lastAccessAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id              String        @id @default(cuid())
  clientId        String
  name            String
  type            String
  scope           String
  description     String?
  status          ProjectStatus @default(DRAFT)
  priority        Priority      @default(MEDIUM)
  progress        Int           @default(0)
  startDate       DateTime?
  deadline        DateTime?
  currentStage    String?
  clientFacingSummary String?
  internalNotes   String?
  visibleToClient Boolean       @default(false)
  managerId       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager            AdminUser?          @relation("ProjectManager", fields: [managerId], references: [id])
  teamMembers        ProjectTeamMember[]
  stages             ProjectStage[]
  briefings          Briefing[]
  briefingResponses  BriefingResponse[]
  approvals          Approval[]
  previews           Preview[]
  clientRequests     ClientRequest[]
  supportTickets     SupportTicket[]
  inboxConversations InboxConversation[]
  files              FileAsset[]
  scheduleEvents     ScheduleEvent[]
  financeRecords     FinanceRecord[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([managerId])
}

model ProjectTeamMember {
  id          String   @id @default(cuid())
  projectId   String
  adminUserId String
  roleLabel   String?
  createdAt   DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, adminUserId])
  @@index([projectId])
  @@index([adminUserId])
}

model ProjectStage {
  id               String      @id @default(cuid())
  clientId         String
  projectId        String
  title            String
  description      String
  status           StageStatus @default(DRAFT)
  clientStatus     String?
  order            Int         @default(0)
  deadline         DateTime?
  sentToClientAt   DateTime?
  requiresApproval Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model Briefing {
  id          String           @id @default(cuid())
  clientId    String
  projectId   String?
  title       String
  type        String?
  description String
  questions   Json?
  status      BriefingStatus   @default(DRAFT)
  visibility  VisibilityStatus @default(INTERNAL)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responses BriefingResponse[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model BriefingResponse {
  id          String   @id @default(cuid())
  briefingId  String
  clientId    String
  projectId   String?
  answers     Json
  submittedAt DateTime @default(now())

  briefing Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([briefingId])
  @@index([clientId])
  @@index([projectId])
}

model Approval {
  id            String         @id @default(cuid())
  clientId      String
  projectId     String?
  previewId     String?
  title         String
  type          String
  message       String
  status        ApprovalStatus @default(DRAFT)
  clientComment String?
  sentAt        DateTime?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  preview Preview? @relation(fields: [previewId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([previewId])
  @@index([status])
}

model Preview {
  id        String        @id @default(cuid())
  clientId  String
  projectId String?
  title     String
  url       String
  version   String
  status    PreviewStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvals Approval[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model ClientRequest {
  id                  String        @id @default(cuid())
  clientId            String
  projectId           String?
  inboxConversationId String?
  title               String
  description         String
  category            String?
  priority            Priority      @default(MEDIUM)
  status              RequestStatus @default(NEW)
  response            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  client            Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inboxConversation InboxConversation?        @relation(fields: [inboxConversationId], references: [id], onDelete: SetNull)
  attachments       ClientRequestAttachment[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
}

model SupportTicket {
  id                  String      @id @default(cuid())
  clientId            String?
  projectId           String?
  inboxConversationId String?
  contactLeadId       String?
  subject             String
  category            String
  priority            Priority    @default(MEDIUM)
  status              InboxStatus @default(NEW)
  lastMessage         String?
  source              InboxSource @default(SUPPORT)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  client            Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inboxConversation InboxConversation?        @relation(fields: [inboxConversationId], references: [id], onDelete: SetNull)
  attachments       SupportTicketAttachment[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
}

model ClientRequestAttachment {
  id              String   @id @default(cuid())
  clientRequestId String
  fileAssetId     String
  createdAt       DateTime @default(now())

  clientRequest ClientRequest @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset     @relation(fields: [fileAssetId], references: [id])

  @@unique([clientRequestId, fileAssetId])
  @@index([clientRequestId])
  @@index([fileAssetId])
}

model SupportTicketAttachment {
  id              String   @id @default(cuid())
  supportTicketId String
  fileAssetId     String
  createdAt       DateTime @default(now())

  supportTicket SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset     @relation(fields: [fileAssetId], references: [id])

  @@unique([supportTicketId, fileAssetId])
  @@index([supportTicketId])
  @@index([fileAssetId])
}

model InboxConversation {
  id         String       @id @default(cuid())
  clientId   String?
  projectId  String?
  channel    InboxChannel
  status     InboxStatus  @default(NEW)
  priority   Priority     @default(MEDIUM)
  source     InboxSource
  subject    String
  preview    String?
  assigneeId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee       AdminUser?      @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages       InboxMessage[]
  clientRequests ClientRequest[]
  supportTickets SupportTicket[]
  contactLead    ContactLead?

  @@index([clientId])
  @@index([projectId])
  @@index([channel])
  @@index([status])
  @@index([priority])
}

model InboxMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  senderType     String
  body           String
  createdAt      DateTime @default(now())

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments  FileAsset[]

  @@index([conversationId])
  @@index([senderId])
}

model FileAsset {
  id                     String             @id @default(cuid())
  clientId               String?
  projectId              String?
  messageId              String?
  uploadedById           String?
  uploadedByType         FileUploadedByType @default(SYSTEM)
  originalName           String             @default("unknown")
  safeName               String             @default("file")
  name                   String
  extension              String             @default("")
  mimeType               String
  detectedMime           String?
  size                   Int
  storageProvider        String
  storageKey             String
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  secureUrl              String?
  url                    String
  origin                 FileOrigin         @default(SYSTEM)
  context                FileContext        @default(CLIENT_FILE)
  visibility             FileVisibility     @default(PRIVATE)
  status                 FileStatus         @default(PENDING_REVIEW)
  riskLevel              FileRiskLevel      @default(DOWNLOAD_ONLY)
  downloadMode           FileDownloadMode   @default(ATTACHMENT_ONLY)
  rejectionReason        String?
  scanStatus             FileScanStatus     @default(NOT_SCANNED)
  scanProvider           String?
  scannedAt              DateTime?
  scanResult             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  client         Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project        Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy     User?                     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  message        InboxMessage?             @relation(fields: [messageId], references: [id], onDelete: SetNull)
  financeReceipt FinanceRecord?            @relation("FinanceReceipt")
  blogCoverPosts BlogPost[]                @relation("BlogCover")
  blogHeroPosts  BlogPost[]                @relation("BlogHero")
  clientRequests ClientRequestAttachment[]
  supportTickets SupportTicketAttachment[]

  @@index([clientId])
  @@index([projectId])
  @@index([messageId])
  @@index([context])
  @@index([status])
  @@index([cloudinaryResourceType])
  @@index([visibility])
  @@index([deletedAt])
}

model ScheduleEvent {
  id          String           @id @default(cuid())
  clientId    String
  projectId   String?
  title       String
  type        String
  date        DateTime
  time        String?
  responsible String?
  notes       String?
  visibility  VisibilityStatus @default(INTERNAL)
  status      String           @default("SCHEDULED")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([date])
}

model FinanceRecord {
  id              String        @id @default(cuid())
  clientId        String
  projectId       String?
  receiptFileId   String?       @unique
  description     String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("BRL")
  dueDate         DateTime
  status          FinanceStatus @default(PENDING)
  installment     String?
  visibleToClient Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  receiptFile FileAsset? @relation("FinanceReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id                 String         @id @default(cuid())
  categoryId         String?
  authorId           String?
  coverFileId        String?
  heroImageFileId    String?
  title              String
  slug               String         @unique
  excerpt            String?
  content            String
  status             BlogPostStatus @default(DRAFT)
  readTime           String?
  insightTitle       String?
  insightDescription String?
  insightCtaLabel    String?
  insightCtaHref     String?
  contextTitle       String?
  contextContent     String?
  practicalTitle     String?
  practicalContent   String?
  seoTitle           String?
  seoDescription     String?
  publishedAt        DateTime?
  scheduledAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  category      BlogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author        AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  coverFile     FileAsset?      @relation("BlogCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  heroImageFile FileAsset?      @relation("BlogHero", fields: [heroImageFileId], references: [id], onDelete: SetNull)
  comments      BlogComment[]
  savedBy       SavedBlogPost[]
  shares        BlogShare[]

  @@index([categoryId])
  @@index([authorId])
  @@index([coverFileId])
  @@index([heroImageFileId])
  @@index([status])
  @@index([publishedAt])
}

model BlogComment {
  id        String            @id @default(cuid())
  postId    String
  userId    String
  body      String
  status    BlogCommentStatus @default(PUBLISHED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model SavedBlogPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model BlogShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  channel   String?
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
}

model NewsletterSubscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  origin    String?
  status    NewsletterStatus @default(NEW)
  interests String[]         @default([])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

model ContactLead {
  id                  String            @id @default(cuid())
  inboxConversationId String?           @unique
  name                String
  email               String
  phone               String?
  company             String?
  projectType         String?
  budget              String?
  timeline            String?
  currentSite         String?
  skills              String?
  message             String
  fileAssetId         String?
  origin              String            @default("site")
  status              ContactLeadStatus @default(NEW)
  responsibleId       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  inboxConversation InboxConversation? @relation(fields: [inboxConversationId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
}

model Notification {
  id          String               @id @default(cuid())
  recipientId String?
  audience    NotificationAudience
  clientId    String?
  projectId   String?
  type        String
  title       String
  body        String?
  entityType  String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  recipient User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([audience])
  @@index([clientId])
  @@index([projectId])
  @@index([readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String
  action     String
  entityType String
  entityId   String?
  clientId   String?
  projectId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([clientId])
  @@index([projectId])
  @@index([createdAt])
}

model CookieConsent {
  id             String   @id @default(cuid())
  userId         String?
  anonymousId    String?
  email          String?
  ipAddress      String?
  userAgent      String?
  source         String
  consentVersion String
  necessary      Boolean  @default(true)
  preferences    Boolean  @default(false)
  analytics      Boolean  @default(false)
  marketing      Boolean  @default(false)
  acceptedAll    Boolean  @default(false)
  rejectedAll    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@index([email])
  @@index([source])
  @@index([createdAt])
}

model PrivacyRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  type         String
  message      String?
  status       String   @default("OPEN")
  internalNote String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}
