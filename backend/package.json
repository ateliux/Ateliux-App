    "cookie-parser": "^1.4.7",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
